{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "read-aloud",
  "title": "Read Aloud",
  "description": "Reads the selected text out loud with an ElevenLabs voice, in any language your models support, and can lower Spotify while it speaks.",
  "icon": "icon.png",
  "author": "eran_knafo",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "read-selection",
      "title": "Read Selection",
      "description": "Read the selected text out loud. Run it again to stop.",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "ElevenLabs API Key",
      "description": "Your ElevenLabs API key. It must be allowed to use text to speech and, for choosing a model per language, to read the model list.",
      "type": "password",
      "required": true
    },
    {
      "name": "speed",
      "title": "Speed",
      "description": "How fast the text is read. Applies from the next reading.",
      "type": "dropdown",
      "required": false,
      "default": "1.5",
      "data": [
        {
          "title": "1×",
          "value": "1"
        },
        {
          "title": "1.25×",
          "value": "1.25"
        },
        {
          "title": "1.5×",
          "value": "1.5"
        },
        {
          "title": "1.75×",
          "value": "1.75"
        },
        {
          "title": "2×",
          "value": "2"
        }
      ]
    },
    {
      "name": "voiceId",
      "title": "Voice",
      "description": "The ElevenLabs voice.",
      "type": "dropdown",
      "required": false,
      "default": "JBFqnCBsd6RMkjVDRZzb",
      "data": [
        {
          "title": "George (Warm, British)",
          "value": "JBFqnCBsd6RMkjVDRZzb"
        },
        {
          "title": "Alice (Confident, British)",
          "value": "Xb7hH8MSUJpSbSDYk0k2"
        },
        {
          "title": "Aria (Expressive, American)",
          "value": "9BWtsMINqrJLrRacOk9x"
        },
        {
          "title": "Bill (Trustworthy, American)",
          "value": "pqHfZKP75CvOlQylNhV4"
        },
        {
          "title": "Brian (Deep, American, Narration)",
          "value": "nPczCjzI2devNBz1zQrb"
        },
        {
