        {
          "title": "Sarah (Soft, American)",
          "value": "EXAVITQu4vr4xnSDxMaL"
        },
        {
          "title": "Will (Friendly, American)",
          "value": "bIHbv24MWmeRgasZH58o"
        }
      ]
    },
    {
      "name": "lowerSpotify",
      "title": "Spotify",
      "label": "Lower Spotify's volume while reading",
      "description": "Turns Spotify down while the text is read and back up afterwards.",
      "type": "checkbox",
      "required": false,
      "default": false
    },
    {
      "name": "spotifyVolume",
      "title": "Spotify Volume While Reading",
      "description": "How loud Spotify stays while reading, as a share of its current volume. Used only when lowering Spotify is turned on.",
      "type": "dropdown",
      "required": false,
      "default": "25",
      "data": [
        {
          "title": "Muted",
          "value": "0"
        },
        {
          "title": "10%",
          "value": "10"
        },
        {
          "title": "20%",
          "value": "20"
        },
        {
          "title": "25%",
          "value": "25"
        },
        {
          "title": "30%",
          "value": "30"
        },
        {
          "title": "40%",
          "value": "40"
        },
        {
          "title": "50%",
          "value": "50"
        },
        {
          "title": "60%",
          "value": "60"
        },
        {
          "title": "70%",
          "value": "70"
        },
        {
          "title": "80%",
          "value": "80"
        },
        {
          "title": "90%",
          "value": "90"
        },
        {
          "title": "100% (leave Spotify alone)",
          "value": "100"
        }
      ]
    },
    {
      "name": "lowerSpotifyElsewhere",
      "title": "Spotify on Another Device",
      "label": "Also lower it when Spotify is not playing on this Mac",
      "description": "Off: the volume is changed only while Spotify is producing sound on this Mac. On: it is changed whenever the Spotify app is open, for example when it is playing on a speaker or phone.",
      "type": "checkbox",
      "required": false,
      "default": false
    },
    {
      "name": "models",
      "title": "Models, in Order",
      "description": "ElevenLabs model IDs separated by commas, fastest first. The first one that supports every language in the text is used; if none does, the last one is.",
      "type": "textfield",
      "required": false,
      "default": "eleven_flash_v2_5, eleven_v4_turbo"
    },
    {
      "name": "typesafeApiKey",
      "title": "TypeSafe API Key",
      "description": "Optional. Used to ask Jev which model in your list supports the text's languages. Without it the first model is always used.",
      "type": "password",
      "required": false
    },
    {
      "name": "cacheSize",
      "title": "Readings to Keep",
      "description": "How many recent readings are kept on this Mac, so that reading the same selection again starts at once and costs nothing. 0 turns this off.",
      "type": "textfield",
      "required": false,
      "default": "10"
    }
  ],
  "dependencies": {
    "@raycast/api": "2.14.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "typescript": "5.6.3",
    "@raycast/eslint-config": "2.2.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
